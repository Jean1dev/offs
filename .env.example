# ── Banco de dados ──────────────────────────────────────
# Connection string do MongoDB (Atlas ou local).
MONGODB_URI="mongodb://localhost:27017/offs"

# ── Autenticação (NextAuth / Auth.js) — Fase 1 ──────────
# Gere com: openssl rand -base64 32
AUTH_SECRET=""
# Credenciais OAuth2 do Google (console.cloud.google.com)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── Provedores de IA (Vercel AI SDK) — Fase 3 ───────────
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""
GOOGLE_GENERATIVE_AI_API_KEY=""

# ── Storage de arquivos (prints do YouTube) ─────────────
# Backend preferencial: Vercel Blob (store público).
# Crie um Blob store no dashboard da Vercel e copie o token read-write.
BLOB_READ_WRITE_TOKEN=""
# Fallback legado: API interna de upload (POST {STORAGE_API_URL}/v1/s3?bucket=...).
# Se nenhum backend estiver configurado, os prints não são persistidos
# (o modelo ainda os recebe inline).
STORAGE_API_URL=""
STORAGE_BUCKET="offs"
